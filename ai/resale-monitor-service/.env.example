DATABASE_URL=postgresql+psycopg2://resale:resale@localhost:5435/resale_monitor_service
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PRICE_ANOMALY_RATIO_THRESHOLD=1.3
HABITUAL_SCORE_THRESHOLD=0.7

TICKET_SERVICE_URL=http://localhost:8081
# 비워두면 정기 크롤 스케줄러가 비활성화되고 /api/resale-monitor/crawl/run 수동 트리거만 동작한다.
CRAWL_SOURCE_URL=
CRAWL_SOURCE_PLATFORM_NAME=ticketbay
CRAWL_INTERVAL_MINUTES=15
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=trueticket
INTERNAL_API_KEY=replace-with-a-random-internal-key
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
MODEL_VERSION=resale-rules-v1
