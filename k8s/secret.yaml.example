# 실제 배포 전 이 파일을 secret.yaml로 복사하고 모든 값을 실제 비밀값으로 교체한 뒤 적용한다.
# secret.yaml은 .gitignore에 등록되어 있어 실수로 커밋되지 않는다.
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   # 값 교체 후:
#   kubectl apply -f k8s/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: trueticket-secrets
  namespace: trueticket
type: Opaque
stringData:
  JWT_SECRET: "replace-with-at-least-32-random-bytes"
  JWT_ISSUER: "trueticket"
  INTERNAL_API_KEY: "replace-with-a-random-internal-key"
  INTERNAL_ADMIT_API_KEY: "replace-with-a-random-admit-key"
  PAYMENT_WEBHOOK_SECRET: "replace-with-a-random-webhook-secret"
  GOOGLE_OAUTH_CLIENT_ID: "replace-with-a-real-google-oauth-client-id"
  GOOGLE_OAUTH_CLIENT_SECRET: "replace-with-a-real-google-oauth-client-secret"
  SENTRY_DSN: ""
  # 서비스별 PostgreSQL 접속 정보 — docker-compose.yml의 값과 동일한 형태이지만,
  # 실제 배포에서는 관리형 DB(RDS 등)를 쓰는 것을 권장한다(k8s/README.md 참고).
  TICKET_DB_URL: "jdbc:postgresql://ticket-db:5432/ticket_service"
  TICKET_DB_USERNAME: "ticket"
  TICKET_DB_PASSWORD: "replace-with-a-real-password"
  NOTIFICATION_DB_URL: "jdbc:postgresql://notification-db:5432/notification_service"
  NOTIFICATION_DB_USERNAME: "notification"
  NOTIFICATION_DB_PASSWORD: "replace-with-a-real-password"
  BOT_DETECTION_DATABASE_URL: "postgresql+psycopg2://botdetect:replace-with-a-real-password@bot-detection-db:5432/bot_detection_service"
  RESALE_MONITOR_DATABASE_URL: "postgresql+psycopg2://resale:replace-with-a-real-password@resale-monitor-db:5432/resale_monitor_service"
  VERIFICATION_DATABASE_URL: "postgresql+psycopg2://verify:replace-with-a-real-password@verification-db:5432/verification_service"
  MINIO_ACCESS_KEY: "replace-with-a-real-access-key"
  MINIO_SECRET_KEY: "replace-with-a-real-secret-key"
  SNAPSHOT_ENCRYPTION_KEY: "replace-with-url-safe-base64-encoded-32-byte-key"
